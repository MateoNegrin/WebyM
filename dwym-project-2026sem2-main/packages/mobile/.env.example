# URL base de la API REST (sin /api al final).
# Para la API local en el emulador de Android usar http://10.0.2.2:4000
# (en un celular físico, la IP de la computadora en la red local, p. ej. http://192.168.1.10:4000).
EXPO_PUBLIC_API_BASE_URL=https://dwym.hardc0de.com
# Identificador de base de datos del equipo, provisto por la cátedra (encabezado x-api-key)
EXPO_PUBLIC_API_KEY=
